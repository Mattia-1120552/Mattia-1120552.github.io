---
import "../styles/global.css";

const base = import.meta.env.BASE_URL;

const experience = [
  {
    period: "JAN — JUN 2025",
    role: "Full-stack developer",
    company: "Robeco · IBS Team",
    description:
      "Bouwde mee aan een intern home portal. Werkte met Vue, Nuxt, TypeScript, SQL en Azure binnen een professioneel Scrum-team.",
  },
  {
    period: "OKT 2024 — JAN 2025",
    role: "Stagiair front-end engineer",
    company: "Robeco · Web Development Team",
    description:
      "Droeg bij aan een Vue 3-migratie, ontwikkelde herbruikbare interfaces en schreef geautomatiseerde Cypress-tests.",
  },
  {
    period: "2025 — 2027",
    role: "Associate degree Software Development",
    company: "Hogeschool Rotterdam",
    description:
      "Verdiept software-engineeringkennis door praktijkprojecten, samenwerking en iteratief bouwen.",
  },
];

const projects = [
  {
    number: "01",
    title: "IBS Home Portal",
    type: "Intern platform · Robeco",
    description:
      "Een modulair startpunt voor interne tools met persoonlijke tegels, permissies, thema’s en beheerfunctionaliteit.",
    tags: ["Vue 3", "PrimeVue", "TypeScript", "Pinia"],
  },
  {
    number: "02",
    title: "Investment Cases",
    type: "Workflow-applicatie · Robeco",
    description:
      "Een datagedreven interface voor analyses en goedkeuringsflows, met rollen, statussen en consistente gebruikersfeedback.",
    tags: ["Vue 3", "DataTable", "Azure", "Cypress"],
  },
];
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfolio van Mattia Warning — software developer met focus op front-end, UX/UI en full-stack development."
    />
    <meta name="theme-color" content="#08110f" />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>Mattia Warning — Software Developer</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Ga naar inhoud</a>

    <header class="site-header" data-header>
      <a
        class="wordmark"
        href="#top"
        aria-label="Mattia Warning, terug naar boven"
      >
        <span>MW</span>
        <small>Software developer</small>
      </a>

      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="navigation"
      >
        <span class="sr-only">Menu openen</span>
        <span></span><span></span>
      </button>

      <nav id="navigation" aria-label="Hoofdnavigatie">
        <a href="#profiel">Profiel</a>
        <a href="#ervaring">Ervaring</a>
        <a href="#werk">Werk</a>
        <a class="nav-contact" href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section class="hero section-shell" id="top">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy reveal">
          <p class="eyebrow">
            <span></span> Den Haag · Beschikbaar om te groeien
          </p>
          <h1>
            Ik bouw digitale<br />
            producten die <em>werken.</em>
          </h1>
          <p class="hero-intro">
            Ik ben Mattia Warning, software developer in opleiding. Mijn focus
            ligt op front-end, UX/UI en full-stack applicaties die helder
            aanvoelen en technisch goed in elkaar zitten.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#werk"
              >Bekijk mijn werk <span>↘</span></a
            >
            <a class="text-link" href="mailto:mattiaabrahamwarning@gmail.com"
              >Plan een gesprek <span>→</span></a
            >
          </div>
        </div>

        <aside class="hero-card reveal reveal-delay">
          <div class="portrait-mark" aria-hidden="true">
            <span>M</span>
          </div>
          <div class="status-row">
            <span class="status-dot"></span>
            <span>Building since 2021</span>
            <span>01 / 04</span>
          </div>
        </aside>

        <div class="hero-index" aria-hidden="true">01</div>
      </section>

      <section class="profile section-shell" id="profiel">
        <div class="section-heading reveal">
          <p class="section-number">02 / PROFIEL</p>
          <h2>
            Nieuwsgierig van nature.<br /><span>Gericht op resultaat.</span>
          </h2>
        </div>

        <div class="profile-grid">
          <div class="profile-story reveal">
            <p class="lead">
              Ik krijg energie van iets creëren dat aan het einde van de dag
              zichtbaar beter is dan aan het begin.
            </p>
            <div class="body-copy">
              <p>
                Mijn manier van werken is praktisch: eerst begrijpen, dan
                bouwen, testen en verbeteren. Ik leer het snelst door zelf
                impact te hebben op het resultaat.
              </p>
              <p>
                Samenwerken maakt mijn werk sterker. Ik zoek actief naar andere
                perspectieven, omdat een goed idee zelden in één hoofd ontstaat.
                Daarbij combineer ik techniek met gevoel voor ontwerp en
                gebruiksgemak.
              </p>
            </div>
          </div>

          <div class="profile-metrics reveal reveal-delay">
            <article>
              <span class="metric-value">01</span>
              <h3>Bouwer</h3>
              <p>Van idee naar een werkend product.</p>
            </article>
            <article>
              <span class="metric-value">02</span>
              <h3>Teamspeler</h3>
              <p>Brainstormen, feedback geven en samen verbeteren.</p>
            </article>
            <article>
              <span class="metric-value">03</span>
              <h3>Visueel denker</h3>
              <p>Techniek en UX samenbrengen in één ervaring.</p>
            </article>
          </div>
        </div>

        <div class="values-strip reveal">
          <p>Wat ik belangrijk vind</p>
          <ol>
            <li><span>01</span> Stabiliteit</li>
            <li><span>02</span> Werk-privébalans</li>
            <li><span>03</span> Groei</li>
            <li><span>04</span> Kwaliteit</li>
            <li><span>05</span> Innovatie</li>
          </ol>
        </div>
      </section>

      <section class="experience section-shell" id="ervaring">
        <div class="section-heading compact reveal">
          <p class="section-number">03 / ERVARING</p>
          <h2>Geleerd door<br /><span>echt te bouwen.</span></h2>
        </div>

        <div class="timeline">
          {
            experience.map((item, index) => (
              <article class="timeline-item reveal">
                <div class="timeline-marker">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                </div>
                <p class="timeline-period">{item.period}</p>
                <div class="timeline-title">
                  <h3>{item.role}</h3>
                  <p>{item.company}</p>
                </div>
                <p class="timeline-description">{item.description}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="work section-shell" id="werk">
        <div class="section-heading reveal">
          <p class="section-number">04 / GESELECTEERD WERK</p>
          <h2>Projecten met een<br /><span>duidelijk doel.</span></h2>
        </div>

        <div class="project-list">
          {
            projects.map((project) => (
              <article class="project-card reveal">
                <div class="project-topline">
                  <span>{project.number}</span>
                  <span>{project.type}</span>
                </div>
                <div class="project-content">
                  <h3>{project.title}</h3>
                  <p>{project.description}</p>
                </div>
                <ul
                  class="tag-list"
                  aria-label={`Technieken gebruikt voor ${project.title}`}
                >
                  {project.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
                <div class="project-arrow" aria-hidden="true">
                  ↗
                </div>
              </article>
            ))
          }
        </div>
        <a
          class="projects-link reveal"
          href="https://github.com/Mattia-1120552"
          target="_blank"
          rel="noreferrer"
        >
          Bekijk meer projecten op GitHub <span>↗</span>
        </a>
      </section>

      <section class="environment section-shell" id="omgeving">
        <div class="environment-panel reveal">
          <p class="section-number">05 / IDEALE OMGEVING</p>
          <blockquote>
            “Een informeel team waar ruimte is om te bouwen, feedback te delen
            en bewezen oplossingen kritisch te verbeteren.”
          </blockquote>
          <div class="environment-details">
            <div><span>TEAM</span><p>Middelgroot en samenwerkend</p></div>
            <div><span>CULTUUR</span><p>Informeel en zorgvuldig</p></div>
            <div>
              <span>RICHTING</span><p>Front-end, UX/UI en full-stack</p>
            </div>
          </div>
        </div>
      </section>

      <section class="contact section-shell" id="contact">
        <div class="contact-copy reveal">
          <p class="section-number">06 / CONTACT</p>
          <h2>Een goed idee<br />begint met <span>contact.</span></h2>
          <p>
            Ik sta open voor een stage, juniorrol of samenwerking waarin ik kan
            blijven bouwen en groeien.
          </p>
          <a
            class="button button-primary button-large"
            href="mailto:mattiaabrahamwarning@gmail.com"
          >
            Stuur mij een e-mail <span>↗</span>
          </a>
        </div>

        <div class="contact-meta reveal reveal-delay">
          <a href="mailto:mattiaabrahamwarning@gmail.com">
            <span>E-MAIL</span>
            mattiaabrahamwarning@gmail.com
          </a>
          <a
            href="https://www.linkedin.com/in/mattia-warning-engineer"
            target="_blank"
            rel="noreferrer"
          >
            <span>LINKEDIN</span>
            /in/mattia-warning-engineer ↗
          </a>
          <a
            href="https://github.com/Mattia-1120552"
            target="_blank"
            rel="noreferrer"
          >
            <span>GITHUB</span>
            /Mattia-1120552 ↗
          </a>
          <div>
            <span>LOCATIE</span>
            Den Haag, Nederland
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer section-shell">
      <p>© {new Date().getFullYear()} Mattia Warning</p>
      <p>Ontworpen en gebouwd met Astro</p>
      <a href="#top">Terug naar boven ↑</a>
    </footer>

    <script>
      const toggle = document.querySelector(".menu-toggle");
      const nav = document.querySelector("#navigation");
      const header = document.querySelector("[data-header]");

      toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!isOpen));
        nav?.classList.toggle("is-open", !isOpen);
      });

      nav?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          toggle?.setAttribute("aria-expanded", "false");
          nav.classList.remove("is-open");
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12 },
      );

      document
        .querySelectorAll(".reveal")
        .forEach((element) => observer.observe(element));

      window.addEventListener(
        "scroll",
        () => header?.classList.toggle("is-scrolled", window.scrollY > 24),
        { passive: true },
      );
    </script>
  </body>
</html>
